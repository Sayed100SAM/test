{
  "name": "cascade/grocery-ecommerce-homepage",
  "type": "project",
  "description": "Responsive Laravel grocery eCommerce homepage.",
  "require": {
    "php": "^8.3",
    "laravel/framework": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "App\\\\": "app/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\\\Foundation\\\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ]
  }
}
